<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/TextoCorpo"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_cartao"
                android:padding="14dp"
                android:text="@string/motorista_aviso_analise" />

            <include
                android:id="@+id/foto"
                layout="@layout/include_foto_perfil" />

            <include
                android:id="@+id/dados"
                layout="@layout/include_dados_pessoais" />

            <EditText
                android:id="@+id/etNascimento"
                style="@style/Campo"
                android:hint="@string/data_nascimento"
                android:inputType="number" />

            <!-- CNH -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/motorista_cnh" />

            <EditText
                android:id="@+id/etCnhNumero"
                style="@style/Campo"
                android:hint="@string/motorista_cnh_numero"
                android:inputType="number"
                android:maxLength="11" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spCnhCategoria"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_campo"
                    android:paddingStart="8dp"
                    android:popupBackground="@color/superficie_alta" />

                <EditText
                    android:id="@+id/etCnhValidade"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:hint="@string/motorista_cnh_validade"
                    android:inputType="number" />
            </LinearLayout>

            <include
                android:id="@+id/fotoCnh"
                layout="@layout/include_foto_documento" />

            <!-- Veículo -->
            <TextView
                style="@style/TituloSecao"
                android:text="@string/motorista_veiculo" />

            <EditText
                android:id="@+id/etMarca"
                style="@style/Campo"
                android:hint="@string/motorista_marca"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etModelo"
                style="@style/Campo"
                android:hint="@string/motorista_modelo"
                android:inputType="textCapWords" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etAno"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:hint="@string/motorista_ano"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/etCor"
                    style="@style/Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:hint="@string/motorista_cor"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPlaca"
                style="@style/Campo"
                android:hint="@string/motorista_placa"
                android:inputType="textCapCharacters|textNoSuggestions" />

            <include
                android:id="@+id/fotoCrlv"
                layout="@layout/include_foto_documento" />

            <include
                android:id="@+id/envio"
                layout="@layout/include_termos_enviar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
