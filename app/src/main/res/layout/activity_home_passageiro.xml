<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/cabecalho"
        layout="@layout/include_cabecalho_usuario" />

    <!-- Fase 2: aqui entra o mapa com a busca de destino. -->
    <LinearLayout
        android:id="@+id/cardParaOnde"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_cartao"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_para_onde"
            android:textColor="@color/amarelo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextoCorpo"
            android:layout_marginTop="4dp"
            android:text="@string/home_para_onde_dica" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:src="@drawable/logo_start" />
</LinearLayout>
