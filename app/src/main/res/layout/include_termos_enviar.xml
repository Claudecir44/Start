<?xml version="1.0" encoding="utf-8"?>
<!-- Aceite dos termos + botão de envio, no fim dos dois cadastros. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbTermos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/amarelo" />

        <TextView
            android:id="@+id/tvTermos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="@string/cadastro_termos"
            android:textColor="@color/texto"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCadastrar"
        style="@style/BotaoPrimario" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/amarelo"
        android:visibility="gone" />
</LinearLayout>
