<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <EditText
            android:id="@+id/etPartida"
            style="@style/Campo"
            android:drawableStart="@drawable/ic_ponto_partida"
            android:drawablePadding="12dp"
            android:hint="@string/corrida_partida"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/etDestino"
            style="@style/Campo"
            android:drawableStart="@drawable/ic_ponto_destino"
            android:drawablePadding="12dp"
            android:hint="@string/corrida_destino"
            android:imeOptions="actionSearch"
            android:inputType="textPostalAddress" />

        <TextView
            android:id="@+id/tvMinhaLocalizacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/corrida_usar_minha_localizacao"
            android:textColor="@color/amarelo"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/amarelo"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSugestoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
