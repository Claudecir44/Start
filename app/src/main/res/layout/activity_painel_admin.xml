<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <!-- Admin logado (tocar na foto troca a foto). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_foto_redonda"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pessoa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPapel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/amarelo"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:text="@string/sair"
            android:textColor="@color/amarelo"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Seções (abrem logo abaixo, na mesma tela). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/btnMotoristas"
            style="@style/BotaoPainel"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/admin_motoristas"
                android:textColor="@color/texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeMotoristas"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:textColor="@color/branco"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnPassageiros"
            style="@style/BotaoPainel"
            android:layout_marginEnd="8dp"
            android:text="@string/admin_passageiros" />

        <TextView
            android:id="@+id/btnAdministradores"
            style="@style/BotaoPainel"
            android:text="@string/admin_administradores" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDica"
        style="@style/TextoCorpo"
        android:padding="24dp"
        android:text="@string/admin_dica" />

    <LinearLayout
        android:id="@+id/areaSecao"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloSecao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/amarelo"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEmAnalise"
                    style="@style/ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_filtro_em_analise" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAprovados"
                    style="@style/ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_filtro_aprovados" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReprovados"
                    style="@style/ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_filtro_reprovados" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBloqueados"
                    style="@style/ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_filtro_bloqueados" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    style="@style/ChipFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_filtro_todos" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnNovoAdmin"
            style="@style/BotaoContorno"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="@string/admin_novo_admin" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/amarelo" />

        <TextView
            android:id="@+id/tvVazio"
            style="@style/TextoCorpo"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/admin_nenhum" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItens"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>
</LinearLayout>
