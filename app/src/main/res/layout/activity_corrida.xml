<?xml version="1.0" encoding="utf-8"?>
<!-- Corrida em andamento (passageiro e motorista usam o mesmo layout; cada
     tela mostra só os botões que fazem sentido pra ela). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapa"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/painel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_painel_inferior"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSituacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/amarelo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhe"
            style="@style/TextoCorpo"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/progressoBusca"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/amarelo"
            android:visibility="gone" />

        <!-- A outra pessoa da corrida. -->
        <LinearLayout
            android:id="@+id/blocoPessoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cartao"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPessoa"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pessoa" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPessoaNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPessoaInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLigar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="@string/corrida_ligar"
                android:textColor="@color/amarelo"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPartida"
            style="@style/LinhaEndereco"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_ponto_partida" />

        <TextView
            android:id="@+id/tvDestino"
            style="@style/LinhaEndereco"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_ponto_destino" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvResumo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/amarelo"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSecundario"
            style="@style/BotaoContorno"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrincipal"
            style="@style/BotaoPrimario"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:padding="8dp"
            android:text="@string/corrida_cancelar"
            android:textColor="@color/vermelho"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
