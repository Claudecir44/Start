<?xml version="1.0" encoding="utf-8"?>
<!-- Topo das telas iniciais: foto, saudação e Sair. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- Foto + "Meu perfil": tocar em qualquer um abre a edição do cadastro. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_foto_redonda"
            android:contentDescription="@string/meu_perfil"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pessoa" />

        <TextView
            android:id="@+id/tvMeuPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingBottom="2dp"
            android:text="@string/meu_perfil"
            android:textColor="@color/amarelo"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLinha2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Sair no alto (acima da linha do nome) e, embaixo, a situação do
         cadastro (só o motorista usa; o passageiro deixa escondido). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="@string/sair"
            android:textColor="@color/amarelo"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSituacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
