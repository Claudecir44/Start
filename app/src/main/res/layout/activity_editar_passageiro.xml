<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/topo"
        layout="@layout/include_topo" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <include
                android:id="@+id/foto"
                layout="@layout/include_foto_perfil" />

            <TextView
                style="@style/TituloSecao"
                android:text="@string/cadastro_dados_pessoais" />

            <TextView
                android:id="@+id/tvFixos"
                style="@style/TextoCorpo"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etNome"
                style="@style/Campo"
                android:hint="@string/nome_completo"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/etTelefone"
                style="@style/Campo"
                android:hint="@string/telefone"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnSalvar"
                style="@style/BotaoPrimario"
                android:layout_marginTop="16dp"
                android:text="@string/editar_salvar" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/amarelo"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
