<?xml version="1.0" encoding="utf-8"?>
<!-- Topo (foto, olá, Sair) | linha | mapa (com a corrida oferecida por cima)
     | linha | botão Ficar online/offline pequeno no canto direito. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/cabecalho"
        layout="@layout/include_cabecalho_usuario" />

    <View style="@style/LinhaDivisoria" />

    <!-- Só aparece fora do "Aprovado" (em análise, reprovado, bloqueado). -->
    <LinearLayout
        android:id="@+id/cardSituacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_cartao"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatusMensagem"
            style="@style/TextoCorpo" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapa"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Corrida mais próxima esperando motorista (por cima do mapa). -->
        <LinearLayout
            android:id="@+id/cardOferta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_painel_inferior"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/oferta_titulo"
                    android:textColor="@color/amarelo"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOfertaValor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/amarelo"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOfertaQuarto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/oferta_quarto_passageiro"
                android:textColor="@color/laranja"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOfertaResumo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOfertaPartida"
                style="@style/LinhaEndereco"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_ponto_partida" />

            <TextView
                android:id="@+id/tvOfertaDestino"
                style="@style/LinhaEndereco"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_ponto_destino" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRecusar"
                    style="@style/BotaoContorno"
                    android:layout_width="0dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="@string/oferta_recusar" />

                <Button
                    android:id="@+id/btnAceitar"
                    style="@style/BotaoPrimario"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:text="@string/oferta_aceitar" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View style="@style/LinhaDivisoria" />

    <!-- Corrida em andamento (no lugar do botão online). Ver PainelCorrida.kt. -->
    <include
        android:id="@+id/painelCorrida"
        layout="@layout/include_painel_corrida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Botão pequeno (metade da largura) no canto inferior direito. -->
    <FrameLayout
        android:id="@+id/rodapeOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnOnline"
            style="@style/BotaoPrimario"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
