<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/cabecalho"
        layout="@layout/include_cabecalho_usuario" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_cartao"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatusTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusMensagem"
            style="@style/TextoCorpo"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMeuCadastro"
        style="@style/BotaoContorno"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:text="@string/editar_meu_cadastro" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvSituacaoOnline"
        style="@style/TextoCorpo"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnOnline"
        style="@style/BotaoPrimario"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:visibility="gone" />
</LinearLayout>
