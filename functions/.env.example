# Copie para functions/.env (que NÃO vai pro GitHub) e preencha.

# Senha exigida pra criar administradores (cadastrarAdmin em index.js).
# Só o administrador master sabe; nunca fica no app.
ADMIN_MASTER_PASSWORD=

# Chave web do projeto (a mesma do app/google-services.json, não é secreta).
# Usada pra conferir a senha de uma conta existente em cadastrarAdmin.
WEB_API_KEY=

# Chave web do Google Maps (Routes API), só no servidor.
MAPS_SERVER_KEY=
