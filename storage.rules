rules_version = '2';

// Fotos de perfil: qualquer usuário logado vê (na corrida, cada lado vê a
// foto do outro). Documentos do motorista (CNH, CRLV): só o dono lê direto;
// o admin abre pelo link de download salvo no perfil do motorista.
//
// Sem firestore.exists() aqui de propósito: a consulta Storage -> Firestore
// depende de um papel que o Google daria automaticamente ao agente do
// Storage, e a organização deste projeto desliga essas concessões — a foto
// do admin era recusada. Quem é admin continua sendo checado no Firestore
// (admins/{uid} só aceita fotoUrl do próprio dono).
service firebase.storage {
  match /b/{bucket}/o {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function imagemValida() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    match /fotos_perfil/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if dono(uid) && imagemValida();
    }

    match /documentos_motorista/{uid}/{arquivo} {
      allow read: if dono(uid);
      allow write: if dono(uid) && imagemValida();
    }

    match /fotos_admin/{uid}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if dono(uid) && imagemValida();
    }
  }
}
